# Configuración de Firebase para IBERNAÚTICA 27
# Si estas variables no están configuradas, la aplicación usará automáticamente
# el almacenamiento local (LocalStorage) con sincronización en memoria y datos precargados.

VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456789
VITE_FIREBASE_AUTH_DOMAIN=ibernautica-27.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ibernautica-27
VITE_FIREBASE_STORAGE_BUCKET=ibernautica-27.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
