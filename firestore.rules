rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite lectura a todos y creación/modificación de preguntas del foro
    match /forum_questions/{questionId} {
      allow read: if true;
      allow create: if request.resource.data.title is string && request.resource.data.title.size() > 3;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'upvotedBy', 'comments', 'updatedAt']);
    }
    
    match /registrations/{regId} {
      allow create: if true;
      allow read: if false; // Solo admins
    }
  }
}
